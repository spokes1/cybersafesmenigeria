/* CyberSafe SME Nigeria: browser-only 15-question Security Self-Check v2. */
(()=>{'use strict';const root=document.getElementById('sc2-root'), form=document.getElementById('sc2-form');if(!root||!form)return;
const Q=__QUESTIONS__, A=__ANSWERS__,KEY='cybersafe.selfcheck.v2',answers={},byId=Object.fromEntries(Q.map(q=>[q.id,q]));
const progress=document.getElementById('sc2-progress'),result=document.getElementById('sc2-result'), business=document.getElementById('sc2-business');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let storedOK=true;try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(x&&x.version===2){for(const q of Q){if(A.some(a=>a.id===x.answers?.[q.id]&&(a.id!=='na'||q.allow_na))){answers[q.id]=x.answers[q.id]}}business.value=String(x.business||'').slice(0,70)}}catch(e){storedOK=false}
const persist=()=>{try{localStorage.setItem(KEY,JSON.stringify({version:2,answers,business:business.value.slice(0,70)}));storedOK=true}catch(e){storedOK=false} progress.dataset.saved=storedOK?'yes':'no'};
const answered=()=>Q.filter(q=>answers[q.id]).length;
function status(){const n=answered();progress.textContent=`${n} of 15 questions answered.${storedOK?'':' Browser storage is unavailable: your answers will last only for this page session.'}`;}
Q.forEach(q=>{if(answers[q.id]){const input=form.querySelector(`input[name="${q.id}"][value="${answers[q.id]}"]`);if(input)input.checked=true}});
function recommendations(){const rank={'not_yet':0,'not_sure':1,'partly':2};return Q.filter(q=>answers[q.id]&&answers[q.id]!=='in_place'&&answers[q.id]!=='na').sort((a,b)=>a.priority-b.priority||rank[answers[a.id]]-rank[answers[b.id]]||Q.indexOf(a)-Q.indexOf(b));}
// Descriptive, stable guide titles: the route is used only as the href.
const GUIDE_TITLES={
 '/learn/password-security':'Password Security',
 '/protect-your-business/account-security':'Account Security',
 '/learn/whatsapp-security':'WhatsApp Security',
 '/protect-your-business/payment-security':'Payment Security',
 '/threats/business-email-compromise':'Business Email Compromise',
 '/threats/social-engineering':'Social Engineering',
 '/protect-your-business/device-security':'Device Security',
 '/resources/tools':'Security Tools',
 '/learn/data-protection':'Data Protection',
 '/learn/backup-and-recovery':'Backup & Recovery',
 '/learn/employee-security':'Employee Security',
 '/protect-your-business/incident-response':'Incident Response'
};
const guideTitle=q=>GUIDE_TITLES[q.article]||'Related Security Guide';
const actionText=q=>answers[q.id]==='not_sure'?`Check and confirm whether this practice is in place: ${q.statement}`:answers[q.id]==='partly'?`Finish putting this practice in place: ${q.statement}`:`Start this practice: ${q.statement}`;
function render(shouldScroll=true){const total=answered();if(total!==15){result.hidden=true;status();progress.focus?.();return}
const applicable=Q.filter(q=>answers[q.id]!=='na'),max=2*applicable.length,points=applicable.reduce((a,q)=>a+({'in_place':2,'partly':1}[answers[q.id]]||0),0),pct=max?Math.round(100*points/max):0;
const counts=Object.fromEntries(A.map(a=>[a.id,Q.filter(q=>answers[q.id]===a.id).length]));const priority=recommendations();const top=priority.slice(0,3);
const showList=top.length?top.map((q,i)=>`<li><strong>${esc(actionText(q))}</strong><div><span class="sc2-guide-prefix">Recommended guide: </span><a href="${esc(q.article)}">${esc(guideTitle(q))}</a></div><p class="sc2-printlines">Owner: __________________ &nbsp; By when: ______________</p></li>`).join(''):`<li><strong>Keep these practices working.</strong> Review account access, devices and backup restoration regularly and after staffing or service changes. <a href="/learn/employee-security">Refresh staff guidance</a>.</li>`;
const groups=[...new Set(Q.map(q=>q.group))].map(group=>`<div class="sc2-answer-group"><h3>${esc(group)}</h3>${Q.filter(q=>q.group===group).map(q=>`<p><strong>${q.id}.</strong> ${esc(q.statement)} <b>Answer: ${esc(A.find(a=>a.id===answers[q.id])?.label||'')}</b></p>`).join('')}</div>`).join('');
result.innerHTML=`<div class="sc2-print-head"><img src="/assets/logo/cybersafe-logo-white.png" alt="CyberSafe SME Nigeria logo"><strong>CyberSafe SME Nigeria</strong></div><h2>Your Business Security Self-Check action plan</h2><p>Business/team: <strong>${esc(business.value||'Not specified')}</strong> · Date: <strong>${esc(new Intl.DateTimeFormat('en-GB',{dateStyle:'medium'}).format(new Date()))}</strong></p><p class="sc2-metric">${pct}% checklist-practice progress</p><p>${points} out of ${max} applicable practice points. This is a self-reported progress indicator, <strong>not</strong> a security score, risk grade or compliance result.</p><p><strong>15 of 15 answered.</strong> In place: ${counts.in_place}; Partly: ${counts.partly}; Not yet: ${counts.not_yet}; Not sure: ${counts.not_sure}; Does not apply: ${counts.na}.</p><h3>Three useful next steps</h3><ol class="sc2-actions">${showList}</ol>${priority.length>3?`<details><summary>See ${priority.length-3} other improvements to consider</summary><ol>${priority.slice(3).map(q=>`<li>${esc(actionText(q))} <span class="sc2-guide-prefix">Guide: </span><a href="${esc(q.article)}">${esc(guideTitle(q))}</a></li>`).join('')}</ol></details>`:''}<h3>All answers by area</h3>${groups}<p class="sc2-printlines">Next review date: ______________ &nbsp; Responsible person: ______________</p><p>For awareness and planning only. No cybersecurity audit, guarantee, risk assessment or proof of compliance. The self-reported answers stay in this browser. Do not print or share internal results carelessly.</p><button class="btn p sc2-print-button" type="button" id="sc2-print">Print or save my results as PDF</button>`;
const printHead=`<div class="sc2-sheet-head"><img src="/assets/logo/cybersafe-logo-white.png" alt="CyberSafe SME Nigeria logo"><strong>CyberSafe SME Nigeria</strong><span>Private self-check action plan</span></div>`;
const printGroup=(group)=>`<div class="sc2-print-group"><h3>${esc(group)}</h3>${Q.filter(q=>q.group===group).map(q=>`<p><b>${q.id}.</b> ${esc(q.statement)} <strong>Answer: ${esc(A.find(a=>a.id===answers[q.id])?.label||'')}</strong></p>`).join('')}</div>`;
const gs=[...new Set(Q.map(q=>q.group))];
const p1=`<section class="sc2-sheet">${printHead}<h2>Business Security Self-Check results</h2><p>Business: ${esc(business.value||'Not specified')} &nbsp; Date: ${esc(new Intl.DateTimeFormat('en-GB',{dateStyle:'medium'}).format(new Date()))}</p><h3>${pct}% checklist-practice progress</h3><p>${points}/${max} applicable practice points. 15/15 answered. In place: ${counts.in_place}; Partly: ${counts.partly}; Not yet: ${counts.not_yet}; Not sure: ${counts.not_sure}; Does not apply: ${counts.na}.</p><p>Self-reported practice indicator only, not a cybersecurity risk, compliance or certification score.</p><h3>Three useful next steps</h3><ol>${top.length?top.map(q=>`<li>${esc(actionText(q))}<p>Recommended guide: <a href="${esc(q.article)}">${esc(guideTitle(q))}</a></p><p>Owner: ______________ Due: ______________</p></li>`).join(''):'<li>Maintain your practices and review after changes.</li>'}</ol><p>Further improvements: ${Math.max(priority.length-3,0)}. See the on-screen action list for the remaining recommended actions.</p><h3>Review and follow-up notes</h3><p>What will we check first? __________________________________________________</p><p>Who is responsible? _____________________________________________________</p><p>What should we verify with staff or a service provider? ______________________________</p><p>Next review date: _________________________________________________________</p></section>`;
const p2=`<section class="sc2-sheet">${printHead}<h2>Answers by area · 1–3</h2>${gs.slice(0,3).map(printGroup).join('')}</section>`;
const p3=`<section class="sc2-sheet">${printHead}<h2>Answers by area · 4–5</h2>${gs.slice(3).map(printGroup).join('')}<p>Next review date: ___________________ &nbsp; Responsible person: ___________________</p><p>Educational guidance only; no audit, guarantee or proof of compliance. Keep completed copies private. Do not record passwords, OTPs or recovery codes.</p></section>`;
result.insertAdjacentHTML('beforeend',`<div class="sc2-print-document" aria-hidden="true">${p1}${p2}${p3}</div>`);
result.hidden=false;result.querySelector('#sc2-print').addEventListener('click',()=>window.print());if(shouldScroll)result.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});
}
form.addEventListener('change',e=>{if(e.target.matches('input[type="radio"]')){answers[e.target.name]=e.target.value;result.hidden=true;persist();status()}});
business.addEventListener('input',()=>{persist();if(!result.hidden)render(false)});form.addEventListener('submit',e=>{e.preventDefault();if(answered()!==15){status();const missing=Q.find(q=>!answers[q.id]);const input=form.querySelector(`input[name="${missing.id}"]`);input?.focus();progress.textContent=`Answer all 15 questions before viewing results. ${answered()} of 15 answered.`;return}render()});
document.getElementById('sc2-reset').addEventListener('click',()=>{if(!confirm('Clear all answers on this device?'))return;Q.forEach(q=>delete answers[q.id]);form.reset();business.value='';try{localStorage.removeItem(KEY)}catch(e){storedOK=false}result.hidden=true;status()});status();
})();